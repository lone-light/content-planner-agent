# 默认调用 DeepSeek；离线验证时显式改为 mock。
AGENT_MODEL_MODE=live
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型可按账号可用情况修改。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=45
AGENT_MAX_STEPS=12
# 故障注入仅供验收，默认关闭。
AGENT_SIMULATION_ENABLED=false
SERVER_PORT=8081
# 正常运行使用 MySQL 8.4；数据库先创建为 content_planner。
AGENT_DB_URL=jdbc:mysql://127.0.0.1:3307/content_planner?connectionTimeZone=UTC&characterEncoding=UTF-8
MYSQL_USER=planner
MYSQL_PASSWORD=
# 以下两项用于 docker compose；使用已有 MySQL 时不需要 root 密码。
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
